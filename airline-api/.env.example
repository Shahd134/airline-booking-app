PORT=5000
NODE_ENV=development

# MongoDB
# ملاحظة مهمة: الـ Booking transactions (session.withTransaction) محتاجة Replica Set.
# - MongoDB Atlas (السحابي) بيدعم ده تلقائيًا حتى في الـ Free Tier.
# - لو شغال محليًا (mongod عادي standalone) الـ transactions هترمي خطأ؛
#   شغّل mongod كـ replica set بعضو واحد: mongod --replSet rs0  ثم rs.initiate() في الـ mongo shell.
MONGO_URI=mongodb://127.0.0.1:27017/airline_api

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
